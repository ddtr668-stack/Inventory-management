{
  "manifest_version": 3,
  "name": "삼성이엔지 이카운트 재고봇",
  "version": "1.0.0",
  "description": "이카운트에 로그인한 브라우저에서 재고현황과 재고변동표를 엑셀로 받습니다.",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": ["downloads", "scripting"],
  "host_permissions": ["https://*.ecount.com/*"],
  "background": { "service_worker": "worker.js" },
  "externally_connectable": {
    "matches": ["https://ddtr668-stack.github.io/Inventory-management/*"]
  }
}
